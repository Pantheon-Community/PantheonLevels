{
    "private": true,
    "type": "module",
    "module": "src/main.ts",
    "scripts": {
        "dev": "bun --watch run src/main.ts",
        "start": "bun .",
        "format": "oxfmt --check",
        "format-fix": "oxfmt",
        "typecheck": "bun run tsc --project tsconfig.strict.json",
        "check-all": "bun run format && bun run typecheck"
    },
    "dependencies": {
        "discord.js": "^14.27.0"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "oxfmt": "^0.44.0"
    },
    "peerDependencies": {
        "typescript": "^6.0.3"
    }
}
